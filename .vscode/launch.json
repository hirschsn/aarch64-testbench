{
    "configurations": [
    {
        "name": "(gdb) Target Launch w/ QEmu",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build/my_test",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${fileDirname}",
        "environment": [ ],
        "externalConsole": false,
        "MIMode": "gdb",
